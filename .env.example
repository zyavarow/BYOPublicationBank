# Copy this file to ".env" and fill it in. Never commit ".env" (git ignores it).

# --- needed everywhere
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/publication_bank
# Shared default Anthropic key. Each organization can also enter its own on the Review & Launch page.
ANTHROPIC_API_KEY=

# --- docker compose only
POSTGRES_PASSWORD=

# --- online installations
# 1 on any installation reachable from the internet (secure cookies, no folder import from the server's disk).
PUBBANK_HOSTED=0
# Any long random text. Required on a hosted installation: it must be typed once to create the first (owner) account.
PUBBANK_SETUP_CODE=
# Switch off paid steps in a preview or demo. Any of: full_run, topic_ai, sample_run, schema_ai  (comma-separated).
PUBBANK_BLOCK=
# A folder for this installation's own files (organization settings, uploaded PDFs). The Docker image sets it to /data.
PUBBANK_HOME=

# --- optional
NCBI_EMAIL=
NCBI_API_KEY=

# Email for sign-in links (Resend). Leave empty to run without email.
RESEND_API_KEY=
PUBBANK_MAIL_FROM=
PUBBANK_MAIL_FROM_NAME=
# password (default), both, or link
PUBBANK_LOGIN=password
