# Papers, extracted text, and databases never go in git
data/
!data/raw/.gitkeep
*.db
*.sqlite
# Secrets
.env
# Large downloads, other people's tools, Office temp files
OneDrive_*.zip
SkyWhal3/
~$*
# Python
__pycache__/
.venv/
venv/
*.pyc

# Organization contact details, logos and uploaded brand guides stay local
orgs/*/config.toml
orgs/*/logo.*
orgs/*/brand_guide.*
orgs/*/uploads/
orgs/*/proposal.json
# An organization's own Anthropic key
orgs/*/api_key.txt
orgs/*/api_key.tmp

# Organization-specific material stays local (each organization's settings, schemas, interviews, letters, test questions)
orgs/
docs/organization_update_*
docs/gold_questions_*
docs/extraction_schema_*.xlsx
docs/HANDOFF_FOR_NEW_CHAT.md
